{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.mudgalapurana.com"
        }
      ],
      "destination": "https://mudgalapurana.com/$1",
      "permanent": true
    }
  ],
  "buildCommand": "npm run build"
}
